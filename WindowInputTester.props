<?xml version="1.0" encoding="utf-8"?>
<!--
  What every WindowInputTester project is built with: CommonLibraries' Common.props, which says how a sheet is used.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\CommonLibraries\Common.props" />
</Project>
